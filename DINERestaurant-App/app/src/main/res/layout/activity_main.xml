<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <LinearLayout
        android:id="@+id/customBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/bg_bottom_nav_with_border"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp">

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/homeIconContainer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:foregroundGravity="center"
                android:gravity="center">

                <ImageView
                    android:id="@+id/homeIcon"
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_home"
                    app:tint="@color/dine_bg_gray" />
            </FrameLayout>

            <TextView
                android:id="@+id/homeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="@color/orange"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>


        <!-- ORDER -->
        <LinearLayout
            android:id="@+id/tabOrder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foregroundGravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/orderIconContainer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/orderIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_order"
                    app:tint="@color/gray" />
            </FrameLayout>

            <TextView
                android:id="@+id/orderLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="Orders"
                android:textColor="@color/orange"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>


        <!-- SCAN -->
        <LinearLayout
            android:id="@+id/tabScan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/scanIconContainer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:foregroundGravity="center"
                android:gravity="center">

                <ImageView
                    android:id="@+id/scanIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_scanqr"
                    app:tint="@color/gray" />
            </FrameLayout>

            <TextView
                android:id="@+id/scanLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="Scan"
                android:textColor="@color/orange"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- NOTIFY -->
        <LinearLayout
            android:id="@+id/tabNotify"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/notifyIconContainer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:foregroundGravity="center"
                android:gravity="center">

                <ImageView
                    android:id="@+id/notifyIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_notification"
                    app:tint="@color/gray" />
            </FrameLayout>

            <TextView
                android:id="@+id/notifyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="Notify"
                android:textColor="@color/orange"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>


        <!-- PROFILE -->
        <LinearLayout
            android:id="@+id/tabProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/profileIconContainer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:foregroundGravity="center"
                android:gravity="center">

                <ImageView
                    android:id="@+id/profileIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_profile"
                    app:tint="@color/gray" />
            </FrameLayout>

            <TextView
                android:id="@+id/profileLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="Profile"
                android:textColor="@color/orange"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>



</androidx.coordinatorlayout.widget.CoordinatorLayout>