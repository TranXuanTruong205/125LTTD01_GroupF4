<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- BACK + TITLE -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_white"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_left"
                android:layout_alignParentStart="true" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Profile"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="8dp" />

        </RelativeLayout>

        <!-- AVATAR -->
        <RelativeLayout
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="30dp">

            <!-- Vòng tròn nền xám nhạt -->
            <ImageView
                android:id="@+id/imgAvatarBg"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:background="@drawable/bg_circle_gray"
                android:scaleType="centerCrop" />

            <!-- Icon người màu xám, căn giữa -->
            <ImageView
                android:id="@+id/imgAvatar"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_profile_placeholder"
                app:tint="#A0A0A0"
                android:scaleType="centerInside"
                android:adjustViewBounds="true" />

            <!-- Nút Edit -->
            <ImageView
                android:id="@+id/btnEditAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_margin="4dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="111dp"
                android:background="@drawable/bg_circle_orange"
                android:padding="10dp"
                android:src="@drawable/ic_edit" />

        </RelativeLayout>



        <!-- PHONE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_input">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_vietnam_flag" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_arrow_down" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(+84)"
                android:textSize="16sp"
                android:textColor="@color/gray"
                android:layout_marginStart="12dp" />

            <EditText
                android:id="@+id/edtPhone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="000 000 000"
                android:textSize="16sp"
                android:paddingStart="16dp"
                android:inputType="phone" />
        </LinearLayout>

        <!-- EMAIL -->
        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input"
            android:paddingStart="16dp"
            android:text="xuantruong277@gmail.com"
            android:textSize="16sp"
            android:inputType="textEmailAddress" />

        <!-- FULL NAME -->
        <EditText
            android:id="@+id/edtFullName"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input"
            android:paddingStart="16dp"
            android:hint="Full Name"
            android:text="Trần Xuân Trường"
            android:textSize="16sp"
            android:inputType="text" />

        <!-- DATE OF BIRTH -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/edtDob"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="false"
                android:hint="--/--/----"
                android:inputType="none"
                android:paddingStart="16dp"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/btnCalendar"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="15dp"
                android:src="@drawable/ic_calendar"
                android:layout_marginTop="12dp"/>

        </RelativeLayout>

        <!-- GENDER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input">

            <TextView
                android:id="@+id/edtGender"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:hint="Gender"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:background="@android:color/transparent" />

            <ImageView
                android:id="@+id/btnGenderDropdown"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:paddingTop="10dp"
                android:src="@drawable/ic_arrow_down"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="14dp"/>

        </RelativeLayout>

        <!-- LOCATION -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input">

            <EditText
                android:id="@+id/edtLocation"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:hint="Your Location"
                android:textSize="16sp"
                android:background="@android:color/transparent" />

            <ImageView
                android:id="@+id/btnLocation"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_location"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="15dp"/>

        </RelativeLayout>

        <!-- CONTINUE BUTTON -->
        <Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_btn_signin"
            android:text="Continue"
            android:textColor="@color/white"
            android:textSize="18sp" />

    </LinearLayout>

</ScrollView>
