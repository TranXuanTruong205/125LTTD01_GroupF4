<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:src="@drawable/ic_arrow_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:background="@drawable/fp_bg_circle_shadow"
                android:contentDescription="Go back" />


            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Profile"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

            <ImageButton
                android:src="@drawable/ic_more"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:background="@drawable/fp_bg_circle_shadow"
                android:contentDescription="More options" />

        </LinearLayout>

        <!-- USER CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:background="@drawable/fp_bg_user_card">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/pic_avatar_default"
                android:scaleType="centerCrop"
                 />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Trần Xuân Trường"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#1A1A1A" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="(+84) 393 999 999"
                    android:textColor="#757575"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="xuantruong277@gmail.com"
                    android:textColor="#757575"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageButton
                android:src="@drawable/ic_edit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="@drawable/fp_bg_circle_edit"
                android:contentDescription="Edit profile" />

        </LinearLayout>

        <!-- LOGOUT BUTTON -->
        <LinearLayout
            android:gravity="center"
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/fp_bg_logout"

            android:orientation="horizontal"
            android:paddingHorizontal="16dp">


            <ImageView
                android:src="@drawable/ic_logout"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:tint="#FF6B6B" />

            <TextView
                android:layout_width="82dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Logout"
                android:textColor="#FF6B6B"

                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- MENU LIST -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp">

            <!-- My Locations -->
            <LinearLayout
                android:id="@+id/llMyLocations"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_location" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="16dp"
                    android:text="My Locations"
                    android:textSize="16sp"
                    android:textColor="#1A1A1A" />

                <ImageView
                    android:src="@drawable/ic_arrow_right"
                    android:layout_width="20dp"
                    android:layout_height="20dp" />
            </LinearLayout>

            <!-- My Promotions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_promotion" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="16dp"
                    android:text="My Promotions"
                    android:textSize="16sp"
                    android:textColor="#1A1A1A" />

                <ImageView
                    android:src="@drawable/ic_arrow_right"
                    android:layout_width="20dp"
                    android:layout_height="20dp" />
            </LinearLayout>

            <!-- Payment Methods -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_payment" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="16dp"
                    android:text="Payment Methods"
                    android:textSize="16sp"
                    android:textColor="#1A1A1A" />

                <ImageView
                    android:src="@drawable/ic_arrow_right"
                    android:layout_width="20dp"
                    android:layout_height="20dp" />
            </LinearLayout>

            <!-- Messages -->
            <LinearLayout
                android:id="@+id/btnmessages"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_chat" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="16dp"
                    android:text="Messages"
                    android:textSize="16sp"
                    android:textColor="#1A1A1A" />

                <ImageView
                    android:src="@drawable/ic_arrow_right"
                    android:layout_width="20dp"
                    android:layout_height="20dp" />
            </LinearLayout>

            <!-- Liked -->
            <LinearLayout
                android:id="@+id/llLiked"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_heart"
                    app:tint="@color/black"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="16dp"
                    android:text="Liked"
                    android:textSize="16sp"
                    android:textColor="#1A1A1A" />

                <ImageView
                    android:src="@drawable/ic_arrow_right"
                    android:layout_width="20dp"
                    android:layout_height="20dp" />
            </LinearLayout>

            <!-- Orders -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_list" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="16dp"
                    android:text="Orders"
                    android:textSize="16sp"
                    android:textColor="#1A1A1A" />

                <ImageView
                    android:src="@drawable/ic_arrow_right"
                    android:layout_width="20dp"
                    android:layout_height="20dp" />
            </LinearLayout>

            <!-- Help Center -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_help" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="16dp"
                    android:text="Help Center"
                    android:textSize="16sp"
                    android:textColor="#1A1A1A" />

                <ImageView
                    android:src="@drawable/ic_arrow_right"
                    android:layout_width="20dp"
                    android:layout_height="20dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- SETTINGS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Language"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvLanguage"
                android:layout_width="141dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_spinner"
                android:paddingHorizontal="12dp"
                android:gravity="center_vertical"
                android:text="English"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:drawableEnd="@drawable/ic_down"
                android:drawablePadding="8dp" />

        </LinearLayout>


        <Switch
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Push Notification"
            android:textSize="16sp" />

        <Switch
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Dark Mode"
            android:textSize="16sp" />

        <Switch
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Sound"
            android:textSize="16sp" />

        <Switch
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Automatically Updated"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
