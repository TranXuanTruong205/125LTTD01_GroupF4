<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBackHeader"
            android:src="@drawable/ic_arrow_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notification"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <ImageButton
            android:id="@+id/btnMarkAllRead"
            android:src="@drawable/ic_more"
        android:padding="10dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle_white"/>

    </LinearLayout>

    <!-- SEARCH -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@drawable/fno_bg_search_round"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        android:layout_marginTop="18dp"
        android:backgroundTint="#F3F3F3"
        android:padding="8dp">

        <ImageView
            android:src="@drawable/ic_search"
            android:layout_width="24dp"
            android:layout_height="24dp" />

        <EditText
            android:id="@+id/edtSearchNotification"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="    Search"
            android:textSize="14sp"
            android:background="@android:color/transparent" />

        <ImageView
            android:src="@drawable/ic_filter"
            android:layout_width="24dp"
            android:layout_height="24dp" />
    </LinearLayout>

    <!-- TODAY -->
    <TextView
        android:id="@+id/txtTodayLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:textSize="16sp"
        android:layout_marginTop="20dp" />

    <!-- DANH SÁCH THÔNG BÁO (ĐỔ TỪ API) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerNotifications"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"/>
</LinearLayout>
